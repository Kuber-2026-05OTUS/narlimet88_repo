apiVersion: v1
kind: Config
clusters:
- name: minikube
  cluster:
    server: https://192.168.49.2:8443
    certificate-authority-data: 

contexts:
- name: cd
  context:
    cluster: minikube
    namespace: homework
    user: cd

current-context: cd

users:
- name: cd
  user:
    token: <SERVICE_ACCOUNT_TOKEN>
